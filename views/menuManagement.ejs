  </head>
  <body>

    <header>
      <button id="backButton" onclick="window.history.back()">Back</button>
      <h1>Menu Management</h1>
    </header>

    <div class="container">
      <button class="add-button" onclick="document.getElementById('formContainer').style.display='flex'">Add New Item</button>

      <div class="form-container" id="formContainer" style="display:none;">
        <form action="/owner/menuManagement/add" method="POST" id="addForm">
          <input type="text" name="name" id="itemName" placeholder="Item Name" required />
          <input type="text" name="category" id="category" placeholder="Category" required />
          <input type="number" name="price" id="price" placeholder="Price" step="0.01" required />
          <select name="status" id="status" required>
            <option value="Available">Available</option>
            <option value="Out of Stock">Out of Stock</option>
            <option value="Coming Soon">Coming Soon</option>
          </select>
          <textarea name="description" id="description" placeholder="Description" required></textarea>
          <input type="text" name="imageUrl" id="imageUrl" placeholder="Image URL" />
          <button type="submit" class="submit-button">Submit</button>
          <button type="button" onclick="document.getElementById('formContainer').style.display='none'">Cancel</button>
        </form>
      </div>

      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Description</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="menuTable">
          <% products.forEach(function(product) { %>
            <tr>
              <td><%= product.name %></td>
              <td><%= product.category || 'N/A' %></td>
              <td>$<%= product.price.toFixed(2) %></td>
              <td><%= product.description %></td>
              <td class="status <%= product.status ? 'status-' + product.status.toLowerCase().replace(/\s/g, '') : '' %>"><%= product.status || 'Available' %></td>
              <td class="actions">
                <!-- Edit button -->
                 <div class="edit_button_outer">
                  <button type="button" class="edit-btn" onclick="toggleEdit('<%= product._id %>')">Edit</button>
                </div>
                <!-- Delete button -->
                <form action="/owner/menuManagement/delete/<%= product._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this item?');">
                  <button type="submit" class="delete">Delete</button>
                </form>

                <!-- Inline edit form (hidden initially) -->
                <div id="editForm-<%= product._id %>" class="edit-form" style="display:none; margin-top:5px;">
                  <form action="/owner/menuManagement/edit/<%= product._id %>" method="POST">
                    <input type="text" name="name" value="<%= product.name %>" required />
                    <input type="text" name="category" value="<%= product.category || '' %>" />
                    <input type="number" name="price" value="<%= product.price %>" step="0.01" required />
                    <select name="status">
                      <option value="Available" <%= product.status === 'Available' ? 'selected' : '' %>>Available</option>
                      <option value="Out of Stock" <%= product.status === 'Out of Stock' ? 'selected' : '' %>>Out of Stock</option>
                      <option value="Coming Soon" <%= product.status === 'Coming Soon' ? 'selected' : '' %>>Coming Soon</option>
                    </select>
                    <textarea name="description"><%= product.description %></textarea>
                    <input type="text" name="imageUrl" value="<%= product.image || '' %>" />
                    <button type="submit">Save</button>
                    <button type="button" onclick="toggleEdit('<%= product._id %>')">Cancel</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <script>
      // Toggle inline edit form visibility
      function toggleEdit(id) {
        const form = document.getElementById('editForm-' + id);
        form.style.display = (form.style.display === 'none' || form.style.display === '') ? 'block' : 'none';
      }
    </script>

  </body>
</html>
